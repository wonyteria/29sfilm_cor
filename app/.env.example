# Database: Supabase PostgreSQL connection string.
# Use the Shared Pooler session mode for IPv4/local/Vercel compatibility.
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-[POOLER_ID]-[REGION].pooler.supabase.com:5432/postgres?schema=public"

# Supabase Storage: used for coupon Excel, submission Excel, and certificate template files.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_STORAGE_BUCKET="29with-files"
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-or-publishable-key"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
ADMIN_SIGNUP_CODE="change-this-before-admin-signup"

# Operational notices: Gmail SMTP.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="gmail-app-password"
MAIL_FROM="your-email@gmail.com"
CRON_SECRET="change-this-random-secret"

# PDF Korean font. Required on Vercel for reliable Korean PDF output.
CERTIFICATE_FONT_PATH="/var/task/fonts/NotoSansKR-Regular.ttf"
